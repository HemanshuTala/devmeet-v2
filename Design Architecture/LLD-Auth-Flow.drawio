        <!-- ═══ FLOW 1: REGISTER ═══ -->
        <mxCell id="bg1" value="sd  [Flow 1: Register]" style="rounded=0;fillColor=#f9f9f9;strokeColor=#000;fontSize=10;fontStyle=2;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="28" y="136" width="1300" height="148" as="geometry"/>
        </mxCell>
        <mxCell id="r1a1" value="POST /auth/register {email, password, display_name}" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="160"/></Array><Array as="targetPoint"><mxPoint x="445" y="160"/></mxGeometry></mxCell>
        <mxCell id="r1t1" value="validate · bcrypt(cost=12) · check email unique" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="164" width="280" height="14" as="geometry"/></mxCell>
        <mxCell id="r1a2" value="INSERT user_profiles · user_plans(free) · usage_quotas" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="184"/></Array><Array as="targetPoint"><mxPoint x="615" y="184"/></mxGeometry></mxCell>
        <mxCell id="r1a2r" value="user_id" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="615" y="200"/></Array><Array as="targetPoint"><mxPoint x="445" y="200"/></mxGeometry></mxCell>
        <mxCell id="r1a3" value="SET refresh:{SHA256(token)} → user_id  TTL 7d" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="216"/></Array><Array as="targetPoint"><mxPoint x="785" y="216"/></mxGeometry></mxCell>
        <mxCell id="r1a4" value="publish user.registered → welcome email" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="232"/></Array><Array as="targetPoint"><mxPoint x="1140" y="232"/></mxGeometry></mxCell>
        <mxCell id="r1a5" value="200 {access_token, refresh_token, expires_in}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="270"/></Array><Array as="targetPoint"><mxPoint x="105" y="270"/></mxGeometry></mxCell>

        <!-- ═══ FLOW 2: LOGIN + MFA ═══ -->
        <mxCell id="bg2" value="sd  [Flow 2: Login (email/password) + MFA]" style="rounded=0;fillColor=#f9f9f9;strokeColor=#000;fontSize=10;fontStyle=2;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="28" y="296" width="1300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="l2a1" value="POST /auth/login {email, password}" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="322"/></Array><Array as="targetPoint"><mxPoint x="445" y="322"/></mxGeometry></mxCell>
        <mxCell id="l2t1" value="check login_attempts → locked? 429" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="326" width="240" height="14" as="geometry"/></mxCell>
        <mxCell id="l2a2" value="SELECT user WHERE email" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="346"/></Array><Array as="targetPoint"><mxPoint x="615" y="346"/></mxGeometry></mxCell>
        <mxCell id="l2a2r" value="user row" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="615" y="360"/></Array><Array as="targetPoint"><mxPoint x="445" y="360"/></mxGeometry></mxCell>
        <mxCell id="l2t2" value="bcrypt.verify(plain, hash) · check is_blocked" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="364" width="280" height="14" as="geometry"/></mxCell>

        <!-- MFA opt -->
        <mxCell id="bg2mfa" value="opt [mfa_enabled = true]" style="rounded=0;fillColor=#fffde7;strokeColor=#000;fontSize=9;fontStyle=2;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="430" y="382" width="660" height="50" as="geometry"/></mxCell>
        <mxCell id="l2mfa1" value="SET mfa_temp:{token} TTL 5min  →  202 {mfa_token}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="410"/></Array><Array as="targetPoint"><mxPoint x="105" y="410"/></mxGeometry></mxCell>

        <mxCell id="l2a3" value="POST /auth/mfa/login-verify {mfa_token, totp_code}" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="442"/></Array><Array as="targetPoint"><mxPoint x="445" y="442"/></mxGeometry></mxCell>
        <mxCell id="l2a4" value="GET mfa_temp · verify TOTP (pyotp)" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="458"/></Array><Array as="targetPoint"><mxPoint x="785" y="458"/></mxGeometry></mxCell>
        <mxCell id="l2t3" value="issue JWT pair · INSERT login_history" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="465" width="260" height="14" as="geometry"/></mxCell>
        <mxCell id="l2a5" value="200 {access_token, refresh_token}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="490"/></Array><Array as="targetPoint"><mxPoint x="105" y="490"/></mxGeometry></mxCell>

        <!-- ═══ FLOW 3: OAUTH2 ═══ -->
        <mxCell id="bg3" value="sd  [Flow 3: OAuth2 — Google / GitHub]" style="rounded=0;fillColor=#f9f9f9;strokeColor=#000;fontSize=10;fontStyle=2;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="28" y="518" width="1300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="o3a1" value="GET /auth/oauth/google" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="544"/></Array><Array as="targetPoint"><mxPoint x="445" y="544"/></mxGeometry></mxCell>
        <mxCell id="o3t1" value="SET state:{csrf} Redis 5min  →  302 redirect to provider" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="548" width="380" height="14" as="geometry"/></mxCell>
        <mxCell id="o3a2" value="GET /auth/oauth/callback?code=…&amp;state=…" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="572"/></Array><Array as="targetPoint"><mxPoint x="445" y="572"/></mxGeometry></mxCell>
        <mxCell id="o3a3" value="verify CSRF · exchange code for token" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="588"/></Array><Array as="targetPoint"><mxPoint x="960" y="588"/></mxGeometry></mxCell>
        <mxCell id="o3a3r" value="user profile {email, name, avatar}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="960" y="604"/></Array><Array as="targetPoint"><mxPoint x="445" y="604"/></mxGeometry></mxCell>
        <mxCell id="o3t2" value="UPSERT user_profiles (google_id / github_id)  ·  issue JWT pair" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="610" width="400" height="14" as="geometry"/></mxCell>
        <mxCell id="o3a4" value="302 → /dashboard?token=…" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="642"/></Array><Array as="targetPoint"><mxPoint x="105" y="642"/></mxGeometry></mxCell>

        <!-- ═══ FLOW 4: REFRESH + LOGOUT ═══ -->
        <mxCell id="bg4" value="sd  [Flow 4: Token Refresh &amp; Logout]" style="rounded=0;fillColor=#f9f9f9;strokeColor=#000;fontSize=10;fontStyle=2;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="28" y="670" width="1300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="r4a1" value="POST /auth/refresh {refresh_token}" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="696"/></Array><Array as="targetPoint"><mxPoint x="445" y="696"/></mxGeometry></mxCell>
        <mxCell id="r4a2" value="GET refresh:SHA256(token)" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="712"/></Array><Array as="targetPoint"><mxPoint x="785" y="712"/></mxGeometry></mxCell>
        <mxCell id="r4a2r" value="user_id" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="785" y="726"/></Array><Array as="targetPoint"><mxPoint x="445" y="726"/></mxGeometry></mxCell>
        <mxCell id="r4t1" value="DEL old token (rotation) · SET new refresh · new access JWT 15min" style="text;html=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="448" y="730" width="400" height="14" as="geometry"/></mxCell>
        <mxCell id="r4a3" value="200 {access_token, refresh_token}" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="752"/></Array><Array as="targetPoint"><mxPoint x="105" y="752"/></mxGeometry></mxCell>
        <mxCell id="r4a4" value="POST /auth/logout" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="105" y="774"/></Array><Array as="targetPoint"><mxPoint x="445" y="774"/></mxGeometry></mxCell>
        <mxCell id="r4a5" value="DEL refresh:{hash}" style="endArrow=open;endFill=0;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="790"/></Array><Array as="targetPoint"><mxPoint x="785" y="790"/></mxGeometry></mxCell>
        <mxCell id="r4a6" value="204 No Content" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000;strokeWidth=1.5;fontSize=9;" edge="1" parent="1"><mxGeometry><Array as="sourcePoint"><mxPoint x="445" y="800"/></Array><Array as="targetPoint"><mxPoint x="105" y="800"/></mxGeometry></mxCell>

        <!-- JWT NOTE -->
        <mxCell id="note1" value="note: JWT Access Token (HS256, 15min)&#xa;{sub, role, email, jti, iat, exp}&#xa;Refresh = 64-byte hex → SHA-256 → Redis (7d, rotating)" style="shape=note;rounded=0;fillColor=#ffffcc;strokeColor=#000;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1370" y="296" width="260" height="65" as="geometry"/>
