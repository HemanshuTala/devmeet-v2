# ────────────────────────────────────────────────
#  DevMeet v2.0 — Environment Configuration
#  Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# ── Database (PostgreSQL 16) ──────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devmeet
POSTGRES_USER=devmeet
POSTGRES_PASSWORD=devmeet_password

# ── Redis 7.2 (session cache, rate limiting) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Elasticsearch 8.11 (question bank search) ─
ELASTICSEARCH_HOST=http://localhost:9200

# ── RabbitMQ 3.12 (inter-service events) ──────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Kafka 3.6 (analytics event streaming) ─────
KAFKA_BROKERS=localhost:9092

# ── Groq LLM API (AI Interviewer) ─────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── AWS S3 (file storage, PDF exports) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=devmeet-files

# ── AWS SES (transactional email) ──────────────
SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@devmeet.com

# ── JWT Authentication ─────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LiveKit (WebRTC video rooms) ───────────────
# Get credentials at https://cloud.livekit.io
LIVEKIT_URL=wss://livekit.devmeet.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Razorpay (payment gateway) ─────────────────
# Get credentials at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Frontend ───────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Service Ports ──────────────────────────────
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
ORCHESTRATOR_SERVICE_PORT=8003
AI_INTERVIEWER_SERVICE_PORT=8004
CODE_EXECUTION_SERVICE_PORT=8005
VIDEO_SERVICE_PORT=8006
FEEDBACK_SERVICE_PORT=8007
NOTIFICATION_SERVICE_PORT=8008
ANALYTICS_SERVICE_PORT=8009
ADMIN_SERVICE_PORT=8010
FILE_SERVICE_PORT=8011
PAYMENT_SERVICE_PORT=8012
SEARCH_SERVICE_PORT=8013

# ── API Gateway (Nginx) ───────────────────────
API_GATEWAY_PORT=8000
